---
import "../styles/global.css";

interface Props {
    title: string;
    album: string;
    artist: string;
    explicit: boolean;
    id: string;
    coverURL: string;
}

import Card from "../components/Card.astro";
import Background from "../components/Background.astro";

import { ClientRouter } from "astro:transitions";

import spotifyLogo from "../assets/spotify_logo.svg";

// import { fetchSpotifyToken, fetchRandomTrack } from "../scripts/spotify-api";

// const token = await fetchSpotifyToken();
// const randomSong = await fetchRandomTrack(token);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#fff8ab" />
        <meta
            name="description"
            content={`${Astro.props.title} by ${Astro.props.artist} - ${Astro.props.album}`}
        />

        <meta property="og:site_name" content="song of the day" />
        <meta
            property="og:title"
            content={`song of the day - ${Astro.props.title} by ${Astro.props.artist}`}
        />
        <meta property="og:description" content={`${Astro.props.album}`} />
        <meta property="og:image" content={Astro.props.coverURL} />
        <meta property="og:type" content="website" />

        <title>song of the day - {Astro.props.title}</title>
        <link rel="icon" type="image/png" href="/favicon.png" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
            rel="stylesheet"
        />

        <ClientRouter />
    </head>
    <body>
        <main class="text-center">
            <Background coverURL={Astro.props.coverURL} />
            <div
                class="p-4 flex flex-col justify-center items-center w-screen min-h-screen relative"
            >
                <h1
                    class="uppercase text-5xl min-[380px]:text-7xl mb-8 min-[380px]:w-96 min-[690px]:w-screen px-8"
                >
                    SONG OF THE DAY
                </h1>

                <div class="p-4 w-xl max-w-full min-w-0">
                    <Card
                        title={Astro.props.title}
                        album={Astro.props.album}
                        artist={Astro.props.artist}
                        explicit={Astro.props.explicit}
                        id={Astro.props.id}
                        coverURL={Astro.props.coverURL}
                    />

                    <slot />

                    <div
                        class="flex flex-col min-[320px]:flex-row justify-center items-center gap-2 mt-4"
                    >
                        <p class="mt-4 min-[320px]:mb-4 mb-0 text-sm">
                            music data provided by
                        </p>
                        <img
                            src={spotifyLogo.src}
                            class="h-6 min-[320px]:mb-0 mb-4"
                            alt="Spotify icon"
                        />
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>
